2. МЕТОД ЗОЛОТОГО СЕЧЕНИЯ

2.1 Постановка задачи

Требуется найти минимум функции

\[
f(x)=2x^2-2x+2.5
\]

на интервале

\[
[-1;9].
\]

Метод золотого сечения использует две внутренние точки, положение которых определяется пропорцией золотого сечения. После первой итерации одна из ранее вычисленных точек сохраняется, поэтому на каждой следующей итерации требуется только одно новое вычисление функции. 

Зададим:

\[
a_0=-1,\qquad b_0=9,
\]

\[
l=1.
\]

Используем коэффициент:

\[
\frac{3-\sqrt5}{2}\approx0.38196.
\]


---

2.2 Алгоритм метода золотого сечения

Шаг 1. Задать:

\[
L_0=[a_0,b_0],
\]

\[
l>0.
\]

Шаг 2.

\[
k=0.
\]

Шаг 3. Вычислить:

\[
y_0=a_0+
\frac{3-\sqrt5}{2}(b_0-a_0),
\]

\[
z_0=a_0+b_0-y_0.
\]

В расчётах:

\[
\frac{3-\sqrt5}{2}=0.38196.
\]

Шаг 4. Вычислить:

\[
f(y_k),\qquad f(z_k).
\]

Шаг 5. Сравнить значения функции.

Если

\[
f(y_k)\leq f(z_k),
\]

то:

\[
a_{k+1}=a_k,
\qquad
b_{k+1}=z_k,
\]

\[
y_{k+1}=a_{k+1}+b_{k+1}-y_k,
\]

\[
z_{k+1}=y_k.
\]

Если

\[
f(y_k)>f(z_k),
\]

то:

\[
a_{k+1}=y_k,
\qquad
b_{k+1}=b_k,
\]

\[
y_{k+1}=z_k,
\]

\[
z_{k+1}=a_{k+1}+b_{k+1}-z_k.
\]

Шаг 6. Вычислить длину интервала:

\[
l_k=|a_{k+1}-b_{k+1}|.
\]

Если

\[
l_k\leq l,
\]

процесс заканчивается.

Приближённое решение:

\[
x^*=
\frac{a_{k+1}+b_{k+1}}2.
\]

Если

\[
l_k>l,
\]

положить

\[
k=k+1
\]

и продолжить вычисления. 


---

2.3 Код программы

#include <iostream>
#include <cmath>
#include <iomanip>

using namespace std;

// Функция, минимум которой ищем
double f(double x)
{
    return 2.0 * x * x - 2.0 * x + 2.5;
}

// Метод золотого сечения
double golden_section(double a, double b, double l, int& N)
{
    N = 0;

    double k = 0.38196;

    double y = a + k * (b - a);
    double z = a + b - y;

    double fy = f(y);
    double fz = f(z);

    while (true)
    {
        cout << "\nИтерация " << N + 1 << endl;

        cout << "a = " << a
             << ", b = " << b << endl;

        cout << "y = " << y
             << ", f(y) = " << fy << endl;

        cout << "z = " << z
             << ", f(z) = " << fz << endl;

        if (fy <= fz)
        {
            b = z;

            z = y;
            fz = fy;

            y = a + k * (b - a);
            fy = f(y);
        }
        else
        {
            a = y;

            y = z;
            fy = fz;

            z = a + b - y;
            fz = f(z);
        }

        N++;

        double l_k = b - a;

        cout << "Новый интервал: ["
             << a << "; " << b << "]" << endl;

        cout << "l_k = " << l_k << endl;

        if (l_k <= l)
        {
            break;
        }
    }

    return (a + b) / 2.0;
}

int main()
{
    double a0 = -1.0;
    double b0 = 9.0;

    double l = 1.0;

    cout << fixed << setprecision(4);

    cout << "Метод золотого сечения" << endl;
    cout << "Функция: f(x) = 2x^2 - 2x + 2.5" << endl;

    cout << "Начальный интервал: ["
         << a0 << "; " << b0 << "]" << endl;

    cout << "Точность l = " << l << endl;

    int N;

    double x_min = golden_section(
        a0, b0, l, N
    );

    double f_min = f(x_min);

    double R = pow(0.618, N - 1);

    cout << "\nРЕЗУЛЬТАТ" << endl;

    cout << "x* = " << x_min << endl;
    cout << "f(x*) = " << f_min << endl;

    cout << "Количество итераций N = "
         << N << endl;

    cout << "Сходимость R_N = "
         << R << endl;

    return 0;
}


