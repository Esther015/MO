3.4 Код программы

#include <iostream>
#include <cmath>
#include <iomanip>

using namespace std;

// Функция для минимизации
double f(double x)
{
    return 2.0 * x * x - 2.0 * x + 2.5;
}

// Метод Фибоначчи
double fibonacci_method(double a, double b,
    double l, double eps, int& N, double& R)
{
    int F[20];

    F[0] = 0;
    F[1] = 1;

    N = 1;

    // Находим N
    while (F[N] < (b - a) / l)
    {
        N++;
        F[N] = F[N - 1] + F[N - 2];
    }

    R = 1.0 / F[N];

    cout << "N = " << N << endl;

    cout << "Числа Фибоначчи:" << endl;

    for (int i = 0; i <= N; i++)
    {
        cout << "F[" << i << "] = "
             << F[i] << endl;
    }

    int k = 0;

    // Начальные точки
    double y = a +
        (double)F[N - 2] / F[N] * (b - a);

    double z = a +
        (double)F[N - 1] / F[N] * (b - a);

    double fy = f(y);
    double fz = f(z);

    cout << fixed << setprecision(4);

    while (k != N - 3)
    {
        cout << "\nИтерация " << k + 1 << endl;

        cout << "a = " << a
             << ", b = " << b << endl;

        cout << "y = " << y
             << ", f(y) = " << fy << endl;

        cout << "z = " << z
             << ", f(z) = " << fz << endl;

        if (fy <= fz)
        {
            b = z;

            z = y;
            fz = fy;

            y = a +
                (double)F[N - k - 3] /
                F[N - k - 1] * (b - a);

            fy = f(y);
        }
        else
        {
            a = y;

            y = z;
            fy = fz;

            z = a +
                (double)F[N - k - 2] /
                F[N - k - 1] * (b - a);

            fz = f(z);
        }

        k++;

        cout << "Новый интервал: ["
             << a << "; " << b << "]" << endl;
    }

    // Заключительное вычисление
    y = (a + b) / 2.0;
    z = y + eps;

    fy = f(y);
    fz = f(z);

    cout << "\nЗаключительное вычисление" << endl;

    cout << "y = " << y
         << ", f(y) = " << fy << endl;

    cout << "z = " << z
         << ", f(z) = " << fz << endl;

    if (fy <= fz)
    {
        b = z;
    }
    else
    {
        a = y;
    }

    cout << "Конечный интервал: ["
         << a << "; " << b << "]" << endl;

    return (a + b) / 2.0;
}

int main()
{
    double a0 = -1.0;
    double b0 = 9.0;

    double l = 1.0;
    double eps = 0.2;

    cout << fixed << setprecision(4);

    cout << "Метод Фибоначчи" << endl;
    cout << "Функция: f(x) = 2x^2 - 2x + 2.5" << endl;

    cout << "Начальный интервал: ["
         << a0 << "; " << b0 << "]" << endl;

    cout << "Точность l = " << l << endl;
    cout << "eps = " << eps << endl;

    int N;
    double R;

    double x_min = fibonacci_method(
        a0, b0, l, eps, N, R
    );

    double f_min = f(x_min);

    cout << "\nРЕЗУЛЬТАТ" << endl;

    cout << "x* = " << x_min << endl;
    cout << "f(x*) = " << f_min << endl;

    cout << "Количество вычислений N = "
         << N << endl;

    cout << "Сходимость R_N = "
         << R << endl;

    return 0;
}


