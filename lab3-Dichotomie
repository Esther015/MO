#include <iostream>
#include <cmath>
#include <iomanip>

using namespace std;

// Функция для минимизации
double f(double x)
{
    return 2.0 * x * x - 2.0 * x + 2.5;
}

// Метод дихотомии
double dichotomy(double a, double b, double eps, double l,
    int& iterations)
{
    iterations = 0;

    double l_k = b - a;

    cout << fixed << setprecision(4);

    while (l_k > l)
    {
        // Вычисление точек y и z
        double y = (a + b - eps) / 2.0;
        double z = (a + b + eps) / 2.0;

        double fy = f(y);
        double fz = f(z);

        cout << "\nИтерация " << iterations << endl;
        cout << "y = " << y << ", f(y) = " << fy << endl;
        cout << "z = " << z << ", f(z) = " << fz << endl;

        // Сравнение f(y) и f(z)
        if (fy < fz)
        {
            b = z;
        }
        else if (fy > fz)
        {
            a = y;
        }

        // Новая длина интервала
        l_k = b - a;

        cout << "Интервал: ["
            << a << "; " << b << "]" << endl;

        cout << "Длина интервала = "
            << l_k << endl;

        iterations++;
    }

    return (a + b) / 2.0;
}

int main()
{
    double a0 = -1.0;
    double b0 = 9.0;

    double eps = 0.2;
    double l = 1.0;

    cout << "Метод дихотомии" << endl;
    cout << "Функция: f(x) = 2x^2 - 2x + 2.5" << endl;
    cout << "Начальный интервал: ["
        << a0 << "; " << b0 << "]" << endl;
    cout << "eps = " << eps << endl;
    cout << "Точность l = " << l << endl;

    int iterations;

    double x_min = dichotomy(
        a0, b0, eps, l, iterations
    );

    double f_min = f(x_min);

    cout << "\nРЕЗУЛЬТАТ" << endl;
    cout << "x* = " << x_min << endl;
    cout << "f(x*) = " << f_min << endl;
    cout << "Количество итераций = "
        << iterations << endl;

    return 0;
}
